<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp" android:gravity="center_vertical">
        <ImageView android:layout_width="72dp" android:layout_height="72dp"
            android:padding="16dp" android:background="@drawable/bg_avatar"
            android:src="@drawable/ic_contacts" android:importantForAccessibility="no"/>
        <TextView style="@style/Subtitle" android:text="@string/app_tagline" android:layout_marginBottom="28dp"/>
        <TextView style="@style/ScreenTitle" android:text="@string/login_title"/>
        <TextView style="@style/Subtitle" android:text="@string/login_subtitle" android:layout_marginBottom="12dp"/>
        <TextView style="@style/FieldLabel" android:text="@string/username"/>
        <EditText android:id="@+id/usernameInput" style="@style/FormInput"
            android:inputType="text" android:singleLine="true" android:hint="@string/username_hint"
            android:imeOptions="actionNext" android:autofillHints="username"/>
        <TextView style="@style/FieldLabel" android:text="@string/password"/>
        <EditText android:id="@+id/passwordInput" style="@style/FormInput"
            android:inputType="textPassword" android:singleLine="true" android:hint="@string/password_hint"
            android:imeOptions="actionDone" android:autofillHints="password"/>
        <TextView android:id="@+id/loginError" style="@style/Subtitle" android:textColor="@color/danger"
            android:accessibilityLiveRegion="polite" android:visibility="gone"
            android:text="@string/invalid_login"/>
        <Button android:id="@+id/loginButton" style="@style/PrimaryButton"
            android:layout_marginTop="20dp" android:text="@string/login"/>
        <TextView style="@style/Subtitle" android:text="@string/demo_account"
            android:gravity="center" android:layout_marginTop="20dp"/>
    </LinearLayout>
</ScrollView>
